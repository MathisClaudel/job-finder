# ═══════════════════════════════════════════════════════════════════
#  Copier ce fichier en `.env` et remplir les valeurs.
#  Le fichier `.env` est ignore par git : les cles n'en sortent jamais.
# ═══════════════════════════════════════════════════════════════════

# ─── France Travail ────────────────────────────────────────────────
# 1. Creer un compte sur https://francetravail.io (gratuit)
# 2. Creer une application, puis s'abonner a l'API "Offres d'emploi v2"
# 3. Copier l'identifiant client et la cle secrete ci-dessous
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ─── Adzuna ────────────────────────────────────────────────────────
# Inscription gratuite sur https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Les autres sources (Remotive, RemoteOK, WeWorkRemotely, Arbeitnow,
# Jobicy, Himalayas, WorkingNomads) sont publiques : aucune cle requise.
